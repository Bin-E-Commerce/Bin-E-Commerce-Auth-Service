# Copy file này thành `.env` khi chạy Auth Service local.
# Không commit password, client secret hoặc internal service token thật lên Git.
#
# Quy tắc theo môi trường:
# - Chạy trực tiếp trên máy: dùng localhost và port được expose ra host.
# - Docker Compose/Kubernetes: đổi localhost thành tên service/DNS nội bộ.
# - Production: inject secret bằng Secret Manager/Kubernetes Secret, không ghi vào image.

# ============================================================================
# 01 · Runtime và HTTP API
# Auth Service xử lý đăng nhập, token, user, quyền truy cập và event seller.
# ============================================================================

NODE_ENV=development                                   # development | test | production
PORT=3002                                              # Port mặc định của Auth Service khi chạy độc lập
APP_VERSION=1.0.0                                      # Version hiển thị trong health response

# ============================================================================
# 02 · Xác thực nội bộ giữa các service
# Gateway và service nội bộ phải dùng cùng token; tuyệt đối không đưa token này
# vào frontend hoặc log request.
# ============================================================================

INTERNAL_SERVICE_TOKEN=

# ============================================================================
# 03 · URL public của frontend và OAuth callback
# Các URL này được dùng khi Auth Service tạo redirect/callback cho frontend.
# ============================================================================

FRONTEND_URL=http://localhost:5173                      # Origin web app
SOCIAL_AUTH_CALLBACK_URL=http://localhost:5173/callback # Callback OAuth của frontend

# ============================================================================
# 04 · PostgreSQL - dữ liệu nguồn của Auth Service
# Database chứa user, refresh token, OTP, role, permission và audit log.
# ============================================================================

POSTGRES_HOST=localhost                                # Docker/K8s: postgres hoặc DNS managed database
POSTGRES_PORT=5432                                     # Port PostgreSQL
POSTGRES_USER=bin_ecommerce                             # User database local
POSTGRES_PASSWORD=
POSTGRES_DB=bin_ecommerce_auth                          # Database riêng của Auth Service

# ============================================================================
# 05 · Redis - OTP, session cache và rate limit
# Redis giúp chia sẻ trạng thái ngắn hạn khi Auth Service chạy nhiều replica.
# ============================================================================

REDIS_HOST=localhost                                    # Docker/K8s: redis hoặc DNS Redis managed
REDIS_PORT=6379                                         # Port Redis
REDIS_PASSWORD=
REDIS_DB=0                                              # Database index dành cho Auth Service

# ============================================================================
# 06 · Kafka - event và consumer seller role
# Auth Service nhận event seller để đồng bộ role/quyền và publish event liên quan.
# ============================================================================

KAFKA_BROKERS=localhost:29092                           # Nhiều broker phân tách bằng dấu phẩy
KAFKA_GROUP_ID=auth-service-seller-role                 # Consumer group phải ổn định giữa các lần restart

# ============================================================================
# 07 · Keycloak realm và client
# KEYCLOAK_URL phải là URL Auth Service truy cập được. Client secret chỉ ở backend.
# Client ID/secret phải khớp cấu hình client tương ứng trong Keycloak realm.
# ============================================================================

KEYCLOAK_URL=http://localhost:8080                      # URL Auth Service gọi nội bộ; Docker/K8s: http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080               # URL trình duyệt dùng để redirect OAuth
KEYCLOAK_REALM=bin-ecommerce                            # Realm phát hành access token
KEYCLOAK_CLIENT_ID=auth-service                         # Client dùng cho token flow của Auth Service
KEYCLOAK_CLIENT_SECRET=

# Client quản trị dùng để tạo/cập nhật user và role trong Keycloak.
KEYCLOAK_ADMIN_CLIENT_ID=auth-service-admin             # Admin client ID
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Client public dùng cho OAuth/PKCE ở frontend; thường không có secret.
KEYCLOAK_WEB_CLIENT_ID=web-client                       # Public web client ID
KEYCLOAK_WEB_CLIENT_SECRET=
