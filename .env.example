# ============================================================
# Auth Service Environment
# ============================================================
# Scope:
# - Copy to services/auth-service/.env for local standalone runs.
# - In production, inject these values only into auth-service by
#   Secret Manager, Kubernetes Secret, ECS Task Definition, or CI/CD secrets.
# - Do not share unrelated service secrets with auth-service.
# ============================================================

# Runtime
NODE_ENV=development
PORT=3002
APP_VERSION=1.0.0

# Internal service authentication
INTERNAL_SERVICE_TOKEN=dev-media-auth-internal-secret

# Public web URLs
FRONTEND_URL=http://localhost:5173
SOCIAL_AUTH_CALLBACK_URL=http://localhost:5173/callback

# PostgreSQL - auth database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bin_ecommerce
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=bin_auth

# Redis - OTP/session support
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka - auth events
KAFKA_BROKERS=localhost:29092

# Keycloak realm
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=bin-ecommerce

# Keycloak confidential client used by auth-service
KEYCLOAK_CLIENT_ID=auth-service
KEYCLOAK_CLIENT_SECRET=changeme_keycloak_secret

# Keycloak public web client used by frontend OAuth/PKCE flow
KEYCLOAK_WEB_CLIENT_ID=web-client
KEYCLOAK_WEB_CLIENT_SECRET=

# Keycloak admin client used for user management
KEYCLOAK_ADMIN_CLIENT_ID=auth-service-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=changeme_admin_client_secret
